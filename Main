<script>

function money(value) {
  return Number(value).toFixed(2) + " درهم";
}

function calculateOrder() {

  const meters =
    parseFloat(document.getElementById("meters").value) || 0;

  const meterPrice =
    parseFloat(document.getElementById("meterPrice").value) || 0;

  const tailoring =
    parseFloat(document.getElementById("tailoring").value) || 0;

  const salePrice =
    parseFloat(document.getElementById("salePrice").value) || 0;


  const fabricCost =
    meters * meterPrice;

  const totalCost =
    fabricCost + tailoring;

  const beforeVat =
    salePrice / 1.05;

  const vatAmount =
    salePrice - beforeVat;

  const profit =
    beforeVat - totalCost;


  document.getElementById("fabricCost").innerText =
    money(fabricCost);

  document.getElementById("tailoringCost").innerText =
    money(tailoring);

  document.getElementById("totalCost").innerText =
    money(totalCost);

  document.getElementById("beforeVat").innerText =
    money(beforeVat);

  document.getElementById("vatAmount").innerText =
    money(vatAmount);

  document.getElementById("finalPrice").innerText =
    money(salePrice);

  document.getElementById("profit").innerText =
    money(profit);
}

</script>

